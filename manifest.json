{
  "manifest_version": 3,
  "name": "Text&JSON Compare",
  "version": "1.0.0",
  "description": "Compare JSON and Text side by side with syntax highlighting",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
